{
  "name": "Yaseen-fyp-root",
  "version": "1.0.0",
  "private": true,
  "description": "Consolidated Node dependencies for Yaseen FYP (desktop app + manager portal + tooling).",
  "scripts": {
    "demo:start": "cd Phase3-Complete && ./run-demo.sh",
    "demo:stop": "cd Phase3-Complete && ./stop-demo.sh",
    "demo:seed": "cd Phase3-Complete/backend && DATABASE_URL=sqlite:///./demo_staging.db SECRET_KEY=demo-staging-secret-key-change-before-release-1234 .venv/bin/alembic upgrade head && DATABASE_URL=sqlite:///./demo_staging.db SECRET_KEY=demo-staging-secret-key-change-before-release-1234 .venv/bin/python scripts/seed_demo_accounts.py",
    "dev:desktop": "cd Phase3-Complete/desktop-app && npm run dev",
    "dev:manager": "cd Phase3-Complete/manager-portal && npm run dev",
    "build:desktop": "cd Phase3-Complete/desktop-app && npm run build",
    "build:manager": "cd Phase3-Complete/manager-portal && npm run build"
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "axios": "^1.6.5",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.2",
    "recharts": "^2.10.4",
    "uuid": "^9.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  }
}
