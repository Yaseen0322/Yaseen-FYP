{
  "name": "employee-activity-tracker",
  "version": "1.0.0",
  "description": "Privacy-Preserving Employee Activity Tracker Desktop App",
  "author": "Yaseen",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node scripts/launch-electron.js",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://127.0.0.1:5173 && node scripts/launch-electron.js\"",
    "dev:renderer": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=700 vite --host 127.0.0.1",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.activitytracker.app",
    "productName": "Activity Tracker",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "dist-renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "axios": "^1.6.5",
    "electron-store": "^8.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.2",
    "recharts": "^2.10.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0",
    "zustand": "^4.4.7"
  }
}
